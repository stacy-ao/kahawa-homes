datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  role         Role       @default(GUEST)
  avatar       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  properties   Property[]
  bookings     Booking[]
  reviews      Review[]
}

model Property {
  id            String         @id @default(cuid())
  name          String
  type          String
  location      String
  lat           Float?
  lng           Float?
  pricePerNight Float
  images        String[]
  amenities     String[]
  rules         String[]
  guests        Int            @default(2)
  bedrooms      Int            @default(1)
  beds          Int            @default(1)
  baths         Int            @default(1)
  rating        Float          @default(5.0)
  reviewsCount  Int            @default(0)
  badge         String?
  description   String
  hostId        String
  host          User           @relation(fields: [hostId], references: [id])
  bookings      Booking[]
  reviews       Review[]
  availabilities Availability[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Booking {
  id            String        @id @default(cuid())
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id])
  guestId       String
  guest         User          @relation(fields: [guestId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  guests        Int           @default(1)
  totalPrice    Float
  status        BookingStatus @default(PENDING)
  paymentRef    String?
  preferences   String[]
  reviews       Review[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Review {
  id          String    @id @default(cuid())
  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  rating      Float
  attributes  String[]
  comment     String?
  createdAt   DateTime  @default(now())
}

model Availability {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  date        DateTime
  isBlocked   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([propertyId, date])
}
